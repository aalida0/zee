{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "dataset_id": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "selection": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "version",
        "url",
        "selection"
      ],
      "additionalProperties": false
    },
    "ordering": {
      "enum": [
        "NO",
        "IO"
      ]
    },
    "observables": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "enum": [
          "sin2_theta12",
          "sin2_theta13",
          "sin2_theta23",
          "dm21_eV2",
          "dm3l_eV2",
          "delta_rad"
        ]
      }
    },
    "units": {
      "type": "object"
    },
    "mean": {
      "type": "array",
      "items": {
        "type": "number"
      }
    },
    "covariance": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "number"
        }
      }
    },
    "likelihood": {
      "const": "GAUSSIAN_APPROXIMATION"
    },
    "assumptions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "schema_version",
    "dataset_id",
    "source",
    "ordering",
    "observables",
    "units",
    "mean",
    "covariance",
    "likelihood",
    "assumptions"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:zee:module2:dataset:1.0.0"
}
