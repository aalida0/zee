# PyR@TE 3 INPUT CANDIDATE -- UNVALIDATED, NOT A CALCULATED RGE!
# Derived structurally from LSartore/pyrate/models/THDM.model and
# Schmidt & Vandeleur arXiv:2512.17235v2 Eq. (3)-(4).
# Exact Weyl f normalization and h.c./matrix assumptions MUST be verified
# by running PyR@TE 3 and matching Kanemura A13 and FLS f=0 results.
# NO Type-II/zero-lambda6,7/GUT hypercharge substitutions are permitted.
---
Author: Zee full-theory exploratory project
Date: 19.10.2026
Name: GeneralZee_CANDIDATE_NOT_VALIDATED
Groups: {U1Y: U1, SU2L: SU2, SU3C: SU3}

Fermions: {
  QL: {Gen: 3, Qnb: {U1Y: 1/6, SU2L: 2, SU3C: 3}},
  LL: {Gen: 3, Qnb: {U1Y: -1/2, SU2L: 2, SU3C: 1}},
  uR: {Gen: 3, Qnb: {U1Y: 2/3, SU2L: 1, SU3C: 3}},
  dR: {Gen: 3, Qnb: {U1Y: -1/3, SU2L: 1, SU3C: 3}},
  eR: {Gen: 3, Qnb: {U1Y: -1, SU2L: 1, SU3C: 1}}
}

RealScalars: {
}

ComplexScalars: {
  Phi1: {RealFields: [Pi1, Sigma1], Norm: 1/sqrt(2), Qnb: {U1Y: 1/2, SU2L: 2, SU3C: 1}},
  Phi2: {RealFields: [Pi2, Sigma2], Norm: 1/sqrt(2), Qnb: {U1Y: 1/2, SU2L: 2, SU3C: 1}},
  chi: {RealFields: [chiR, chiI], Norm: 1/sqrt(2), Qnb: {U1Y: 1, SU2L: 1, SU3C: 1}}
}

Potential: {
  Definitions: {
    Phi1tilde[i]: Eps[i,j] Phi1bar[j],
    Phi2tilde[i]: Eps[i,j] Phi2bar[j]
  },

  Yukawas: {
    Yu1: QLbar[i,a] Phi1tilde[i] uR[a],
    Yu2: QLbar[i,a] Phi2tilde[i] uR[a],
    Yd1: QLbar[i,a] Phi1[i] dR[a],
    Yd2: QLbar[i,a] Phi2[i] dR[a],
    Ye1: LLbar[i] Phi1[i] eR,
    Ye2: LLbar[i] Phi2[i] eR,

    # Weyl LL LL chi term. Flavor antisymmetry and normalization are
    # UNVALIDATED in this candidate. Inspect generator assumptions[f]
    # and match real-f Kanemura (2001) Eq. A13 before using beta_f.
    f: Eps[i,j] LL[i] LL[j] chi
  },

  QuarticTerms: {
    l1: 1/2(Phi1bar[i] Phi1[i] Phi1bar[j] Phi1[j]),
    l2: 1/2(Phi2bar[i] Phi2[i] Phi2bar[j] Phi2[j]),
    l3: Phi1bar[i] Phi1[i] Phi2bar[j] Phi2[j],
    l4: Phi1bar[i] Phi2[i] Phi2bar[j] Phi1[j],
    l5: 1/2(Phi1bar[i] Phi2[i] Phi1bar[j] Phi2[j]),
    l6: Phi1bar[i] Phi2[i] Phi1bar[j] Phi1[j],
    l7: Phi1bar[i] Phi2[i] Phi2bar[j] Phi2[j],

    lh: chibar chi chibar chi,
    l8: chibar chi Phi1bar[i] Phi1[i],
    l9: chibar chi Phi2bar[i] Phi2[i],
    l10: chibar chi Phi1bar[i] Phi2[i]
  },

  ScalarMasses: {
    m1: Phi1bar[i] Phi1[i],
    m2: Phi2bar[i] Phi2[i],
    m12: -Phi1bar[i] Phi2[i],
    mchi: chibar chi
  },

  TrilinearTerms: {
    muZee: Eps[i,j] Phi1[i] Phi2[j] chibar
  }
}

Substitutions: {
  # g1 is the SM hypercharge coupling g', not GUT-normalized.
  g_U1Y: gp,
  g_SU2L: g2,
  g_SU3C: g3
}

Latex: {
  QL: Q_L,
  LL: L_L,
  uR: u_R,
  dR: d_R,
  eR: e_R,
  Phi1: H_1,
  Phi2: H_2,
  chi: h,
  f: f,
  gp: g',
  muZee: \\mu_{Zee},
  l10: \\lambda_{10}
}
