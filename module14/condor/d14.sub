universe = vanilla
executable = worker.sh
arguments = $(shard)
should_transfer_files = YES
when_to_transfer_output = ON_EXIT
transfer_input_files = scan_bundle.tar.gz,bundle.sha256,source_commit.txt,config.json,shards/$(shard)
transfer_output_files = results.jsonl,receipt.json
transfer_output_remaps = "results.jsonl=results/$(shard).$(Cluster).$(Process).jsonl;receipt.json=receipts/$(shard).$(Cluster).$(Process).json"
output = logs/$(Cluster).$(Process).out
error = logs/$(Cluster).$(Process).err
log = logs/$(Cluster).log
request_cpus = 1
request_memory = 2 GB
request_disk = 2 GB
getenv = FALSE
queue shard from shards.txt
