+
+/* One input owns evolution AND all high-scale power/EM terms; no global state. */
+double d9b_bsgamma(struct d9b_matching *input, double mu, double E0,
+                  struct parameters *param, struct d9b_rate_info *info)
+{
+    if(!input || input->scheme!=1 || (input->order!=1 && input->order!=2)
+       || !isfinite(input->mu_W) || input->mu_W<=0. || !isfinite(mu) || mu<=0.
+       || !isfinite(E0) || E0<=0. || 2.*E0>=param->mass_b+0.37) return NAN;
+    /* Kc0/Cem[2] assume the SM LO current-current sector. Reject unsupported NP. */
+    for(int i=1;i<=10;i++) {
+        if(!isfinite(creal(input->C0[i])) || cimag(input->C0[i])!=0.
+           || !isfinite(creal(input->C1[i])) || cimag(input->C1[i])!=0.
+           || !isfinite(creal(input->C2[i])) || cimag(input->C2[i])!=0.
+           || input->Cp[i]!=0.) return NAN; /* ms=0 unprimed scope */
+        if(i<=6 && input->C0[i]!=(i==2 ? 1. : 0.)) return NAN;
+    }
+    double complex C0[11]={0},C1[11]={0},C2[11]={0};
+    C_calculator_base1(input->C0,input->C1,input->C2,input->mu_W,C0,C1,C2,mu,param);
+    return bsgamma_Ecut_core(C0,C1,C2,input->Cp,mu,input->mu_W,E0,param,input,info);
+}
 
